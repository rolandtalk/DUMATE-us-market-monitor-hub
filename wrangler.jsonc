{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "us-market-monitor-hub",
  "compatibility_date": "2026-10-11",
  "main": "worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "us-market-monitor-hub"
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "REPORTS",
      "id": "57b5591964e54de882a6de4268b74fed"
    }
  ],
  "triggers": {
    "crons": [
      "30 21 * * *",
      "30 22 * * *"
    ]
  }
}
